# Development environment
NODE_ENV=development

# Server configuration
PORT=5001

# Database configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/glassStore?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d

# Email configuration for Gmail SMTP
# EMAIL_USER: dia chi Gmail gui mail
# EMAIL_PASS: App Password 16 ky tu tao trong Google Account > Security > App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM_NAME=Glass Store

# Frontend URL used in reset password link
CLIENT_URL=http://localhost:3000

# Keep low for local expiry testing; raise in production as needed
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=1

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret