# App runtime
# development | test | production
NODE_ENV=development

# Express server port
PORT=5001

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ie213_backend

# Optional: public DNS servers used by Node.js for mongodb+srv Atlas lookup
# Useful when nslookup works but Node throws querySrv ECONNREFUSED.
DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT settings
# Use a long random secret in real environments
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRE=30d

# Password reset token lifetime in minutes
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=15

# Frontend URL used for CORS and reset-password links
CLIENT_URL=http://localhost:3001

# Reverse proxy trust setting.
# Keep 0 for direct local/dev traffic. Use 1 only when running behind one trusted proxy.
TRUST_PROXY=0

# Logging
# Log levels: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Enable automatic HTTP request/response logging
ENABLE_REQUEST_LOGGING=true

# Optional external HTTP log sink for centralized log shipping
LOG_SINK_URL=

# Optional bearer token used when forwarding logs to LOG_SINK_URL
LOG_SINK_AUTH_TOKEN=

# SMTP settings for password reset email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=IE213 Backend

# Cloudinary upload settings
CLOUDINARY_UPLOAD_TIMEOUT_MS=10000
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
