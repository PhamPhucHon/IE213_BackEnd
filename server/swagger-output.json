            "description": "ID danh mục. Có thể dùng cùng type để lọc kết hợp",
            "type": "string"
          },
          {
            "name": "brand",
            "in": "query",
            "description": "Thương hiệu sản phẩm",
            "type": "string"
          },
          {
            "name": "minPrice",
            "in": "query",
            "description": "Giá thấp nhất",
            "type": "number"
          },
          {
            "name": "maxPrice",
            "in": "query",
            "description": "Giá cao nhất",
            "type": "number"
          },
          {
            "name": "type",
