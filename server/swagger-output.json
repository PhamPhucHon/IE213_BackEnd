                },
                "newPassword": {
                  "type": "string",
                  "example": "12345678"
                }
              },
              "required": [
                "token",
                "newPassword"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dat lai mat khau thanh cong",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Đặt lại mật khẩu thành công"
                },
                "data": {},
                "meta": {
                  "type": "object",
                  "properties": {
                    "timestamp": {
                      "type": "string",
                      "example": "2026-04-12T15:05:00.000Z"
                    },
                    "requestId": {}
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Token khong hop le hoac da het han",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": false
                },
                "message": {
                  "type": "string",
                  "example": "Token đặt lại mật khẩu không hợp lệ hoặc đã hết hạn."
                },
                "details": {}
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
